# NorthForge Agency OS — environment variables
# Copy to .env.local (git-ignored). NEVER commit real secrets.

# --- Browser-exposed (safe): Vite only exposes VITE_* to the client bundle ---
VITE_SUPABASE_URL=YOUR_URL
VITE_SUPABASE_ANON_KEY=YOUR_KEY  # anon key is designed to be public + guarded by RLS

# --- SERVER ONLY: never prefix with VITE_, never import in client code ---
# Used only by Vercel serverless / edge functions & Supabase admin tasks.
SUPABASE_URL=YOUR_URL
SUPABASE_ANON_KEY=YOUR_KEY
SUPABASE_SERVICE_ROLE_KEY=NEVER-EXPOSE-THIS-TO-THE-BROWSER

# --- Hermes automation engine (server-to-server) ---
# Leave unset until the real Hermes API contract is available. The website
# will queue jobs and honestly report "not configured" — never fake execution.
HERMES_API_URL=
HERMES_API_KEY=
HERMES_CALLBACK_SECRET=        # HMAC secret Hermes uses to sign callbacks
PUBLIC_BASE_URL=https://your-site.vercel.app   # callback URL base for Hermes

# --- Optional NVIDIA Nemotron 3 Lite AI layer (server-side only) ---
NEMOTRON_API_URL=              # optional; defaults to https://integrate.api.nvidia.com/v1
NEMOTRON_API_KEY=nvapi-...     # NVIDIA NIM key — SERVER ONLY, never in Git/browser
NEMOTRON_MODEL=                # optional; defaults to nvidia/nemotron-3.5-lightning-30b-a3b
